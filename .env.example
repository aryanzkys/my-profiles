# Public base path when deploying under a subpath (optional)
# NEXT_PUBLIC_BASE_PATH=""

# Simple client-side admin gate
# Set this to a strong secret and share only with yourself
# NEXT_PUBLIC_ADMIN_KEY="change-me"

# AI assistant (server-side only; never expose this as NEXT_PUBLIC_*)
# GROQ_API_KEY="gsk_your_key_here"
# Optional model override; defaults to qwen/qwen3-32b
# GROQ_MODEL="qwen/qwen3-32b"

# Supabase/Postgres (primary storage)
# SUPABASE_DB_URL="postgresql://postgres:password@db.xxxxxx.supabase.co:5432/postgres"
# If your password has special chars (e.g., #), either URL-encode it or use the discrete config below:
# SUPABASE_DB_HOST="db.xxxxxx.supabase.co"
# SUPABASE_DB_PORT="5432"
# SUPABASE_DB_DATABASE="postgres"
# SUPABASE_DB_USER="postgres"
# SUPABASE_DB_PASSWORD="eF*3_7e#Mgmam#A"

# Optional: Supabase REST (avoids direct DB DNS issues)
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="<service role key>"

# Firebase Authentication (client-side)
# Required for login to work. These are safe to expose on the client.
# NEXT_PUBLIC_FIREBASE_API_KEY=""
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
# NEXT_PUBLIC_FIREBASE_APP_ID=""
# Optional extras if you use them:
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""
# Optional reCAPTCHA v3 site key for added protection on auth actions
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY_V3=""
# Server-side secret (never commit); set in hosting env (e.g., Netlify UI)
# RECAPTCHA_SECRET_KEY=""
# Optional reCAPTCHA v3 score threshold (0.0-1.0). Default 0.5. Higher = stricter
# RECAPTCHA_SCORE_THRESHOLD="0.7"

# SMTP credentials for password reset email (server-side)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# Optional custom sender address
# SMTP_FROM="Aryan Stack Admin <no-reply@aryanstack.netlify.app>"

# Password hashing rounds (bcrypt) for admin credentials. Default 12.
# PASSWORD_SALT_ROUNDS="12"

# Optional overrides for password reset routing
# NEXT_PUBLIC_PASSWORD_RESET_FUNCTION="auth-service"
# NEXT_PUBLIC_PASSWORD_RESET_BASE_URL="https://api.aryanstack.netlify.app"
# NEXT_PUBLIC_PASSWORD_RESET_PORT="5000"
